<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genz Mini App</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1a1a1a;
            color: white;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .header {
            width: 90%;
            padding: 20px;
            text-align: left;
        }
        .card {
            background: linear-gradient(135deg, #8b0000, #4a0000);
            width: 85%;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            margin-bottom: 20px;
        }
        .balance-title { font-size: 14px; opacity: 0.8; }
        .balance-value { font-size: 32px; font-weight: bold; margin: 10px 0; }
        
        .btn-group { display: flex; gap: 10px; }
        .btn {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
        }
        .btn-withdraw { background: white; color: #8b0000; }
        .btn-invite { background: rgba(255,255,255,0.2); color: white; }

        .menu-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            width: 90%;
        }
        .menu-item {
            background: #2d2d2d;
            padding: 15px;
            border-radius: 15px;
            text-align: center;
        }
        .icon { font-size: 24px; margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="header">
        <h2>Hello, <span id="username">User</span> 👋</h2>
        <p style="font-size: 12px; color: #aaa;">Let's earn some money today!</p>
    </div>

    <div class="card">
        <div class="balance-title">TOTAL BALANCE</div>
        <div class="balance-value">Rp <span id="balance">0</span></div>
        <div class="btn-group">
            <button class="btn btn-withdraw">Withdraw</button>
            <button class="btn btn-invite">Invite Friends</button>
        </div>
    </div>

    <div class="menu-grid">
        <div class="menu-item" onclick="alert('Fitur Segera Hadir!')">
            <div class="icon">📋</div>
            <div>Do Tasks</div>
        </div>
        <div class="menu-item" onclick="alert('Fitur Segera Hadir!')">
            <div class="icon">📺</div>
            <div>Watch Ads</div>
        </div>
    </div>

    <script>
        // Inisialisasi Telegram Web App
        const tg = window.Telegram.WebApp;
        tg.expand(); // Biar tampilan penuh

        // Ambil Nama User dari Telegram
        document.getElementById('username').innerText = tg.initDataUnsafe.user.first_name;
    </script>
</body>
</html>
